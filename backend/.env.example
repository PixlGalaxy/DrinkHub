HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# Signs player session tokens. If unset, one is generated and stored in
# storage/server/session.secret so sessions survive restarts.
SESSION_SECRET=

# Storage root. Each module gets its own folder inside it: server/,
# sipitordipit/, pyramid/... Defaults to backend/storage.
DATA_DIR=

# Trust X-Real-IP / X-Forwarded-For (set when running behind nginx)
TRUST_PROXY=true

# Connection lifecycle (seconds)
AWAY_AFTER_SEC=30
SEAT_TTL_SEC=1800
ROOM_IDLE_TTL_SEC=43200

LOG_LEVEL=info
